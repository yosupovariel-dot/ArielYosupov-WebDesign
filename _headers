# קובץ הגדרות אבטחה עבור אחסון סטטי שתומך בפורמט Netlify/Cloudflare Pages (_headers).
# אם תעבור לספק אחסון אחר (למשל Apache/cPanel), יש להעביר הגדרות אלו ל-.htaccess בהתאמה.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
